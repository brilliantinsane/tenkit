{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "paths": {
      "@tenkit/template-generator": ["../template-generator/src/index.ts"],
      "@tenkit/types/generated-app-option-definitions": [
        "../types/src/generated-app-option-definitions.ts"
      ],
      "@tenkit/types/setup-type-definitions": ["../types/src/setup-type-definitions.ts"],
      "@tenkit/types/styling-definitions": ["../types/src/styling-definitions.ts"]
    },
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
