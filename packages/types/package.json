{
  "name": "@tenkit/types",
  "version": "0.2.0",
  "description": "Shared browser-safe product definitions for Tenkit.",
  "license": "MIT",
  "homepage": "https://www.tenkit.dev",
  "bugs": {
    "url": "https://github.com/brilliantinsane/tenkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brilliantinsane/tenkit.git",
    "directory": "packages/types"
  },
  "keywords": [
    "app-variants",
    "expo",
    "multi-tenant",
    "react-native",
    "runtime-tenants",
    "tenkit",
    "typescript",
    "white-label"
  ],
  "type": "module",
  "exports": {
    "./generated-app-option-definitions": "./dist/generated-app-option-definitions.mjs",
    "./setup-type-definitions": "./dist/setup-type-definitions.mjs",
    "./styling-definitions": "./dist/styling-definitions.mjs"
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown src/generated-app-option-definitions.ts src/setup-type-definitions.ts src/styling-definitions.ts --format esm --dts",
    "pack:dry-run": "pnpm pack --dry-run",
    "prepack": "pnpm run build",
    "pretypecheck": "pnpm run build",
    "test": "pnpm run build && vitest run",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "tsdown": "^0.22.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.9"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
