import { Text, View } from 'react-native';

import { useBusinessProfile } from '@/business-data/use-business-profile';
{{#if isClerkAuth}}
import { SignOutButton } from '@/auth/sign-out-button';
{{/if}}
import { useAppVariantConfig } from '@/hooks/use-app-variant-config';

export default function HomeScreen() {
  const { appVariant } = useAppVariantConfig();
  const { profile, error, isLoading } = useBusinessProfile();

  return (
    <View className="flex-1 items-center justify-center gap-4 bg-background px-6">
      <Text className="text-base text-accent font-semibold tracking-normal">
        Tenkit
      </Text>
      <Text className="text-center text-4xl font-bold text-foreground">
        White Label App
      </Text>
      <View className="min-w-56 gap-1">
        <Text selectable className="font-mono text-sm text-foreground">
          Business Data: {isLoading ? 'Loading' : (profile?.name ?? 'Unavailable')}
        </Text>
        {profile ? <Text className="text-base text-muted">{profile.description}</Text> : null}
        {error ? <Text className="text-base text-muted">{error}</Text> : null}
        <Text className="font-mono text-sm text-foreground">Auth: {{#if isClerkAuth}}clerk{{else}}none{{/if}}</Text>
        <Text selectable className="font-mono text-sm text-foreground">
          App Variant: {appVariant.slug}
        </Text>
      </View>
      {{#if isClerkAuth}}<SignOutButton />{{/if}}
      <Text className="max-w-sm text-center text-base text-muted">
        A generated Expo SDK 57 app with White Label app configuration applied.
      </Text>
    </View>
  );
}
