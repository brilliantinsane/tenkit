import '../global.css';

import { DarkTheme, DefaultTheme, ThemeProvider } from 'expo-router/react-navigation';
import { StatusBar } from 'expo-status-bar';
import { useColorScheme } from 'react-native';
import { Uniwind } from 'uniwind';

{{#if isConvexBackend}}
import { ConvexProvider, ConvexReactClient } from 'convex/react';

function resolveConvexDeploymentUrl(): string {
  const deploymentUrl = process.env.EXPO_PUBLIC_CONVEX_URL;
  if (!deploymentUrl) {
    throw new Error('EXPO_PUBLIC_CONVEX_URL is required for the selected Convex Backend.');
  }

  let parsedDeploymentUrl: URL;
  try {
    parsedDeploymentUrl = new URL(deploymentUrl);
  } catch {
    throw new Error('EXPO_PUBLIC_CONVEX_URL must be a valid HTTPS URL.');
  }
  if (parsedDeploymentUrl.protocol !== 'https:') {
    throw new Error('EXPO_PUBLIC_CONVEX_URL must be a valid HTTPS URL.');
  }

  return deploymentUrl;
}

const convexClient = new ConvexReactClient(resolveConvexDeploymentUrl(), {
  unsavedChangesWarning: false,
});
{{/if}}


import AppTabs from '@/components/app-tabs';
import { getAppVariantConfig } from '@/hooks/use-app-variant-config';

const { theme } = getAppVariantConfig();

Uniwind.updateCSSVariables('light', { '--color-accent': theme.accent });
Uniwind.updateCSSVariables('dark', { '--color-accent': theme.accent });

export default function RootLayout() {
  const colorScheme = useColorScheme();
  const dark = colorScheme === 'dark';

  const navigationTheme = {
    ...(dark ? DarkTheme : DefaultTheme),
    colors: {
      ...(dark ? DarkTheme : DefaultTheme).colors,
      primary: theme.accent,
    },
  };

  return (
    {{#if isConvexBackend}}
    <ConvexProvider client={convexClient}>
    {{/if}}
    <>
      <ThemeProvider value={navigationTheme}>
        <AppTabs accent={theme.accent} />
      </ThemeProvider>
      <StatusBar style={dark ? 'light' : 'dark'} />
    </>
    {{#if isConvexBackend}}
    </ConvexProvider>
    {{/if}}
  );
}
