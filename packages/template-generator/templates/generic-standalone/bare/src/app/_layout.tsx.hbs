import { ThemeProvider } from 'expo-router/react-navigation';
import { StatusBar } from 'expo-status-bar';
{{#if isClerkAuth}}
import { useAuth } from '@clerk/expo';
import { Stack } from 'expo-router';
import { ActivityIndicator, View } from 'react-native';
{{/if}}

{{#if isConvexBackend}}
import { ConvexProvider, ConvexReactClient{{#if isClerkAuth}}, useConvexAuth{{/if}} } from 'convex/react';
{{#if isClerkAuth}}
import { ConvexProviderWithClerk } from 'convex/react-clerk';
{{/if}}
{{#if isBetterAuth}}
import { ConvexBetterAuthProvider } from '@convex-dev/better-auth/react';
import { convexBetterAuthClient } from '@/auth/auth-client';
{{/if}}

function resolveConvexDeploymentUrl(): string {
  const deploymentUrl = process.env.EXPO_PUBLIC_CONVEX_URL;
  if (!deploymentUrl) {
    throw new Error('EXPO_PUBLIC_CONVEX_URL is required for the selected Convex Backend.');
  }

  let parsedDeploymentUrl: URL;
  try {
    parsedDeploymentUrl = new URL(deploymentUrl);
  } catch {
    throw new Error('EXPO_PUBLIC_CONVEX_URL must be a valid HTTPS URL.');
  }
  if (parsedDeploymentUrl.protocol !== 'https:') {
    throw new Error('EXPO_PUBLIC_CONVEX_URL must be a valid HTTPS URL.');
  }

  return deploymentUrl;
}

const convexClient = new ConvexReactClient(resolveConvexDeploymentUrl(), {
  {{#if isClerkAuth}}expectAuth: true,
  {{/if}}
  unsavedChangesWarning: false,
});
{{/if}}


import AppTabs from '@/components/app-tabs';
{{#if isClerkAuth}}
import { ClerkAppProvider } from '@/auth/clerk-provider';
import { resolveClerkSessionRouteState } from '@/auth/clerk-session-boundary';
{{/if}}
{{#if isBetterAuth}}
import { BetterAuthBoundary } from '@/auth/better-auth-boundary';
{{/if}}
import { useAppVariantConfig } from '@/hooks/use-app-variant-config';
import { getNavigationTheme } from '@/theme/colors';
import { ColorsProvider, useTheme } from '@/theme/ThemeContext';

function RootLayoutInner() {
  const { brand, dark } = useTheme();
  {{#if isClerkAuth}}
  const { isLoaded, isSignedIn } = useAuth();
  const sessionRouteState = resolveClerkSessionRouteState(isLoaded, isSignedIn);
  {{#if isConvexBackend}}
  const { isAuthenticated, isLoading: isConvexAuthLoading } = useConvexAuth();
  if (isSignedIn && !isConvexAuthLoading && !isAuthenticated) {
    throw new Error(
      'Convex could not verify the Clerk session. Confirm CLERK_FRONTEND_API_URL and sync the Convex deployment.',
    );
  }
  {{/if}}

  if (sessionRouteState === 'loading'{{#if isConvexBackend}} || (isSignedIn && isConvexAuthLoading){{/if}}) {
    return (
      <View style=\{{ flex: 1, alignItems: 'center', justifyContent: 'center' }}>
        <ActivityIndicator color={brand.accent} />
      </View>
    );
  }
  {{/if}}

  return (
    <>
      <ThemeProvider value={getNavigationTheme(dark, brand.primary)}>
        {{#if isClerkAuth}}
        {sessionRouteState === 'app' ? (
          <AppTabs />
        ) : (
          <Stack screenOptions=\{{ headerShown: false }}>
            <Stack.Protected guard={isSignedIn !== true}>
              <Stack.Screen name="(auth)" />
            </Stack.Protected>
            <Stack.Protected guard={isSignedIn === true}>
              <Stack.Screen name="index" />
              <Stack.Screen name="settings" />
            </Stack.Protected>
          </Stack>
        )}
        {{else}}
        {{#if isBetterAuth}}
        <BetterAuthBoundary>
        {{/if}}
        <AppTabs />
        {{#if isBetterAuth}}
        </BetterAuthBoundary>
        {{/if}}
        {{/if}}
      </ThemeProvider>
      <StatusBar style={dark ? 'light' : 'dark'} />
    </>
  );
}

export default function RootLayout() {
  const { theme } = useAppVariantConfig();

  return (
    {{#if isClerkAuth}}
    <ClerkAppProvider>
    {{/if}}
    <ColorsProvider
      brandOverride=\{{
        primary: theme.accent,
        accent: theme.accent,
      }}
    >
      {{#if isConvexBackend}}
      {{#if isBetterAuth}}
      <ConvexBetterAuthProvider authClient={convexBetterAuthClient} client={convexClient}>
      {{else}}
      {{#if isClerkAuth}}
      <ConvexProviderWithClerk client={convexClient} useAuth={useAuth}>
      {{else}}
      <ConvexProvider client={convexClient}>
      {{/if}}
      {{/if}}
      {{/if}}
      <RootLayoutInner />
      {{#if isConvexBackend}}
      {{#if isBetterAuth}}
      </ConvexBetterAuthProvider>
      {{else}}
      {{#if isClerkAuth}}
      </ConvexProviderWithClerk>
      {{else}}
      </ConvexProvider>
      {{/if}}
      {{/if}}
      {{/if}}
    </ColorsProvider>
    {{#if isClerkAuth}}
    </ClerkAppProvider>
    {{/if}}
  );
}
