{
  "name": "{{packageName}}",
  "version": "1.0.0",
  "private": true,
  {{#if hasServerWorkspace}}
  {{#if isNpmPackageManager}}
  "workspaces": ["apps/server"{{#if hasDatabaseWorkspace}}, "packages/db"{{/if}}{{#if hasAuthWorkspace}}, "packages/auth"{{/if}}],
  {{/if}}
  {{#if isBunPackageManager}}
  "workspaces": ["apps/server"{{#if hasDatabaseWorkspace}}, "packages/db"{{/if}}{{#if hasAuthWorkspace}}, "packages/auth"{{/if}}],
  {{/if}}
  {{/if}}
  {{#if isNpmPackageManager}}
  {{#if isBetterAuth}}
  "overrides": { "@better-auth/core": "1.6.25" },
  {{/if}}
  {{/if}}
  "main": "{{#if isUnistylesStyling}}index.ts{{else}}expo-router/entry{{/if}}",
  "scripts": {
    "start": "expo start",
  {{#if isNodeBackend}}
    "dev": "concurrently -k \"expo start\" \"{{#if hasAuthWorkspace}}{{packageManagerAuthRunCommand}} build && {{/if}}{{packageManagerServerRunCommand}} dev\"",
    "build": "{{#if hasDatabaseWorkspace}}{{packageManagerDatabaseRunCommand}} build && {{/if}}{{#if hasAuthWorkspace}}{{packageManagerAuthRunCommand}} build && {{/if}}{{packageManagerServerRunCommand}} build",
    "server:dev": "{{packageManagerServerRunCommand}} dev",
    "server:start:prod": "{{packageManagerServerRunCommand}} start:prod",
    "test": "{{#if hasAuth}}{{packageManagerRunCommand}} test:mobile && {{/if}}{{#if hasDatabaseWorkspace}}{{packageManagerDatabaseRunCommand}} test && {{/if}}{{#if hasAuthWorkspace}}{{packageManagerAuthRunCommand}} test && {{/if}}{{packageManagerServerRunCommand}} test",
    {{#if hasAuth}}
    "test:mobile": "vitest run {{#if isClerkAuth}}src/auth/clerk-business-profile-client.test.ts src/auth/clerk-post-auth-navigation.test.ts src/auth/clerk-session-boundary.test.ts{{else}}src/auth/auth-session-boundary.test.ts{{/if}}",
    {{/if}}
    "test:integration": "{{packageManagerServerRunCommand}} test:integration",
    {{#if hasDatabaseWorkspace}}
    "db:generate": "{{packageManagerDatabaseRunCommand}} generate",
    "db:migrate": "{{packageManagerDatabaseRunCommand}} migrate",
    "db:seed": "{{packageManagerDatabaseRunCommand}} seed",
    "db:setup": "{{packageManagerDatabaseRunCommand}} setup",
    {{/if}}
  {{/if}}
  {{#if isConvexBackend}}
    "dev": "concurrently -k \"expo start\" \"{{packageManagerServerRunCommand}} dev\"",
    "convex:codegen": "{{packageManagerServerRunCommand}} codegen",
    "convex:dev": "{{packageManagerServerRunCommand}} dev",
    "convex:seed": "{{packageManagerServerRunCommand}} seed",
    "convex:sync": "{{packageManagerServerRunCommand}} sync",
    "test": "{{#if isClerkAuth}}{{packageManagerRunCommand}} test:mobile && {{/if}}{{packageManagerServerRunCommand}} test",
    {{#if isClerkAuth}}
    "test:mobile": "vitest run src/auth/clerk-business-profile-client.test.ts src/auth/clerk-post-auth-navigation.test.ts src/auth/clerk-session-boundary.test.ts",
    {{/if}}
    "test:integration": "{{packageManagerServerRunCommand}} test",
  {{/if}}
    "tenkit": "tsx scripts/tenkit-cli.ts",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit --pretty false{{#if hasDatabaseWorkspace}} && {{packageManagerDatabaseRunCommand}} typecheck{{/if}}{{#if hasAuthWorkspace}} && {{packageManagerAuthRunCommand}} typecheck{{/if}}{{#if hasServerWorkspace}} && {{packageManagerServerRunCommand}} typecheck{{/if}}",
    "expo:config": "expo config --type public"
  },
  "dependencies": {
    {{#if isClerkAuth}}
    "@clerk/expo": "4.2.1",
    {{/if}}
    {{#if isBetterAuth}}
    "@better-auth/expo": "1.6.25",
    {{#if isConvexBackend}}
    "@convex-dev/better-auth": "0.12.5",
    {{/if}}
    "better-auth": "1.6.25",
    {{/if}}
    {{#if isConvexBackend}}
    "convex": "1.43.0",
    {{/if}}
    {{#if isUnistylesStyling}}
    "@react-native/normalize-colors": "0.86.0",
    {{/if}}
    {{#if isBareStyling}}
    "@expo/ui": "~57.0.7",
    {{/if}}
    {{#if isUniwindStyling}}
    "clsx": "^2.1.1",
    {{/if}}
    "expo": "~57.0.7",
    "expo-constants": "~57.0.6",
    "expo-dev-client": "~57.0.7",
    "expo-linking": "~57.0.3",
    "expo-router": "~57.0.7",
    {{#if isBetterAuth}}
    "expo-network": "~57.0.1",
    {{/if}}
    {{#if hasAuth}}
    "expo-secure-store": "~57.0.1",
    {{/if}}
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "^4.3.1",
    "react-native-nitro-modules": "{{#if isUnistylesStyling}}0.36.1{{else}}^0.35.9{{/if}}",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    {{#if isUnistylesStyling}}
    "react-native-unistyles": "3.3.0",
    {{/if}}
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0"{{#if isUniwindStyling}},
    "tailwind-merge": "^3.6.0",
    "uniwind": "^1.10.0"{{/if}}
  },
  "devDependencies": {
    "@expo/config-types": "57.0.2",
    "@inquirer/prompts": "^8.5.2",
    "@types/node": "^25.9.3",
    "@types/react": "~19.2.2",
    "commander": "^15.0.0",
    {{#if hasServerWorkspace}}
    "concurrently": "^9.2.1",
    {{/if}}
    {{#if isUniwindStyling}}
    "tailwindcss": "^4.3.2",
    {{/if}}
    "tsx": "^4.22.4",
    "typescript": "~6.0.3"
    {{#if hasAuth}},
    "vitest": "^4.1.9"
    {{/if}}
  }
}
