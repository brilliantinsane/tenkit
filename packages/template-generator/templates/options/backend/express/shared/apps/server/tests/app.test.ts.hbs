import request from 'supertest';
import { describe, expect, test } from 'vitest';

import { createApp } from '../src/app.js';

const app = createApp('http://localhost:8081');

describe('Express Backend', () => {
  test('exposes public health without an Auth route', async () => {
    await request(app).get('/health').expect(200, { status: 'ok' });
    await request(app).get('/api/auth/session').expect(404);
  });

  test('validates context and returns Setup Type-scoped Business Data', async () => {
    await request(app).get('/api/business-profile').expect(400);

{{#ifSetupType 'white-label-apps'}}
    await request(app)
      .get('/api/business-profile')
      .query({ setupType: '{{setupType}}', appVariantId: {{appVariants.[0].appVariantId}} })
      .expect(200, {
        profile: {
          name: {{{appVariants.[0].displayNameStringLiteral}}},
          description: 'The first white-label Business Data Example.',
        },
      });
    await request(app)
      .get('/api/business-profile')
      .query({
        setupType: '{{setupType}}',
        appVariantId: {{appVariants.[0].appVariantId}},
        runtimeTenantId: 100,
      })
      .expect(403);
{{/ifSetupType}}
{{#if isSingleAppRuntimeTenants}}
    await request(app)
      .get('/api/business-profile')
      .query({
        setupType: '{{setupType}}',
        appVariantId: {{appVariants.[0].appVariantId}},
        runtimeTenantId: 100,
      })
      .expect(200, {
        profile: {
          name: 'North Branch',
          description: 'The northern branch Business Data Example.',
        },
      });
    await request(app)
      .get('/api/business-profile')
      .query({
        setupType: '{{setupType}}',
        appVariantId: {{appVariants.[0].appVariantId}},
        runtimeTenantId: 999,
      })
      .expect(403);
{{/if}}
{{#ifSetupType 'generic-with-standalone-app-variants'}}
    await request(app)
      .get('/api/business-profile')
      .query({
        setupType: '{{setupType}}',
        appVariantId: {{appVariants.[0].appVariantId}},
        runtimeTenantId: 100,
      })
      .expect(200, {
        profile: {
          name: 'North Studio',
          description: 'The North Studio Business Data Example.',
        },
      });
    await request(app)
      .get('/api/business-profile')
      .query({
        setupType: '{{setupType}}',
        appVariantId: {{appVariants.[0].appVariantId}},
        runtimeTenantId: 103,
      })
      .expect(403);
    await request(app)
      .get('/api/business-profile')
      .query({
        setupType: '{{setupType}}',
        appVariantId: {{appVariants.[1].appVariantId}},
        runtimeTenantId: 103,
      })
      .expect(200, {
        profile: {
          name: 'West Studio',
          description: 'The standalone West Studio Business Data Example.',
        },
      });
{{/ifSetupType}}
  });
});
