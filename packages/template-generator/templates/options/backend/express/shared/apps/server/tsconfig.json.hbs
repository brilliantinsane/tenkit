{
  "compilerOptions": {
    "declaration": true,
    "esModuleInterop": true,
    "module": "{{#if isClerkAuth}}ESNext{{else}}NodeNext{{/if}}",
    "moduleResolution": "{{#if isClerkAuth}}Bundler{{else}}NodeNext{{/if}}",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
