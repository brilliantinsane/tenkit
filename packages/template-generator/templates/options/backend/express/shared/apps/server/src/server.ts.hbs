import { config } from 'dotenv';
{{#if hasDatabaseWorkspace}}
import { createBusinessDataRepository{{#if isDrizzleOrm}}, {{#if isMysqlDatabase}}createMysqlDrizzleDatabase{{else}}createPostgresqlDrizzleDatabase{{/if}}{{/if}} } from '@tenkit/db';
{{/if}}
{{#if isBetterAuth}}
import { createTenkitAuth } from '@tenkit/auth';
{{/if}}

import { createApp{{#if isBetterAuth}}, createBetterAuthRequestAuthentication{{/if}} } from './app.js';
import { readServerEnvironment } from './environment.js';

config({ path: '.env.local', quiet: true });

const environment = readServerEnvironment();
{{#if hasDatabaseWorkspace}}
{{#if isDrizzleOrm}}
const database = {{#if isMysqlDatabase}}createMysqlDrizzleDatabase{{else}}createPostgresqlDrizzleDatabase{{/if}}(environment.DATABASE_URL);
const businessDataRepository = createBusinessDataRepository(database);
{{else}}
const businessDataRepository = createBusinessDataRepository(environment.DATABASE_URL);
{{/if}}
{{/if}}
{{#if isBetterAuth}}
const { auth{{#if isPrismaOrm}}, close: closeAuth{{/if}} } = createTenkitAuth({
  {{#if isDrizzleOrm}}
  database,
  {{else}}
  databaseUrl: environment.DATABASE_URL,
  {{/if}}
  baseUrl: environment.BETTER_AUTH_URL,
  secret: environment.BETTER_AUTH_SECRET,
  clientOrigin: environment.CLIENT_ORIGIN,
  development: environment.NODE_ENV === 'development',
});
{{/if}}
const server = createApp(
  environment.CLIENT_ORIGIN,
  {{#if hasDatabaseWorkspace}}businessDataRepository,{{/if}}
  {{#if isBetterAuth}}createBetterAuthRequestAuthentication(auth),{{/if}}
).listen(environment.PORT, () => {
  console.log(`Tenkit Express server listening on port ${environment.PORT}.`);
});

let shutdownStarted = false;

async function shutdown(): Promise<void> {
  if (shutdownStarted) {
    return;
  }

  shutdownStarted = true;
  const serverClosed = new Promise<void>((resolve, reject) => {
    server.close((error) => {
      if (error) {
        reject(error);
        return;
      }
      resolve();
    });
  });

  let shutdownFailed = false;

  try {
    await serverClosed;
  } catch {
    shutdownFailed = true;
  }
  {{#if hasDatabaseWorkspace}}
  try {
    await businessDataRepository.close();
  } catch {
    shutdownFailed = true;
  }
  {{/if}}
  {{#if isBetterAuth}}
  {{#if isPrismaOrm}}
  try {
    await closeAuth();
  } catch {
    shutdownFailed = true;
  }
  {{/if}}
  {{/if}}

  if (shutdownFailed) {
    console.error('Tenkit Express server could not close cleanly.');
    process.exitCode = 1;
  }
}

process.once('SIGINT', () => void shutdown());
process.once('SIGTERM', () => void shutdown());
