{
  "name": "@tenkit/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start:prod": "node dist/src/server.js",
    "test": "vitest run tests/app.test.ts",
    "test:integration": "vitest run tests/integration.test.ts",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    {{#if hasDatabaseWorkspace}}
    "@tenkit/db": "{{workspaceDependencyVersion}}",
    {{/if}}
    {{#if isBetterAuth}}
    "@tenkit/auth": "{{workspaceDependencyVersion}}",
    "better-auth": "1.6.25",
    {{/if}}
    {{#if isClerkAuth}}
    "@clerk/express": "2.1.50",
    {{/if}}
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    {{#if isBetterAuth}}
    "@cloudflare/workers-types": "5.20260812.1",
    "@types/bun": "1.3.14",
    {{/if}}
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "{{#if isClerkAuth}}~5.9.3{{else}}~6.0.3{{/if}}",
    "vitest": "^4.1.9"
  }
}
