import {
  Controller,
  Get,
  HttpException,
  {{#if isClerkAuth}}Injectable,
  Query,
  Req,
  UnauthorizedException,{{else}}Query,{{/if}}
} from '@nestjs/common';
{{#if isClerkAuth}}
import { getAuth } from '@clerk/express';
import type { Request } from 'express';
{{/if}}

import { BusinessProfileQueryDto } from './business-profile-query.dto.js';
import {
  BusinessProfileRequestError,
  BusinessProfileService,
} from './business-profile.service.js';

{{#if isClerkAuth}}
@Injectable()
export class ClerkAuthenticationService {
  isAuthenticated(request: Request): boolean {
    return getAuth(request).isAuthenticated;
  }
}

{{/if}}
@Controller('api/business-profile')
export class BusinessProfileController {
  constructor(
    private readonly businessProfiles: BusinessProfileService,
    {{#if isClerkAuth}}private readonly authentication: ClerkAuthenticationService,{{/if}}
  ) {}

  @Get()
  read(
    {{#if isClerkAuth}}@Req() request: Request,
    {{/if}}@Query() query: BusinessProfileQueryDto,
  ) {
    {{#if isClerkAuth}}
    if (!this.authentication.isAuthenticated(request)) {
      throw new UnauthorizedException({ error: 'Authentication is required' });
    }

    {{/if}}
    try {
      return { profile: this.businessProfiles.resolve(query) };
    } catch (error) {
      if (error instanceof BusinessProfileRequestError) {
        throw new HttpException({ error: error.message }, error.status);
      }
      throw error;
    }
  }
}
