{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "module": "{{#if isClerkAuth}}ESNext{{else}}NodeNext{{/if}}",
    "moduleResolution": "{{#if isClerkAuth}}Bundler{{else}}NodeNext{{/if}}",
    "outDir": "dist",
    "removeComments": true,
    "rewriteRelativeImportExtensions": true,
    {{#unless isClerkAuth}}
    "skipLibCheck": true,
    {{/unless}}
    "sourceMap": true,
    "strict": true,
    "target": "ES2023",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
