import { resolve } from 'node:path';

import { z } from 'zod';

const serverEnvironmentSchema = z.object({
  CLIENT_ORIGIN: z.string().url(),
  PORT: z.coerce.number().int().min(1).max(65_535).default(3000),
});

export type ServerEnvironment = z.infer<typeof serverEnvironmentSchema>;

export const serverEnvironmentFile = resolve(import.meta.dirname, '../.env.local');

export function validateServerEnvironment(environment: Record<string, unknown>): ServerEnvironment {
  const parsedEnvironment = serverEnvironmentSchema.safeParse(environment);
  if (!parsedEnvironment.success) {
    throw new Error(`Invalid server environment: ${z.prettifyError(parsedEnvironment.error)}`);
  }

  return parsedEnvironment.data;
}
