import type { INestApplication } from '@nestjs/common';
import { ConfigService } from '@nestjs/config';
import { Test } from '@nestjs/testing';
{{#if hasDatabaseWorkspace}}
import type { BusinessDataRepository } from '@tenkit/db';
{{/if}}
import request from 'supertest';
import { afterAll, beforeAll{{#if isClerkAuth}}, beforeEach{{/if}}, describe, expect, test } from 'vitest';

import { AppModule } from '../src/app.module.js';
{{#if hasDatabaseWorkspace}}
import { BUSINESS_DATA_REPOSITORY } from '../src/business-profile/business-profile.service.js';
{{/if}}
{{#if isClerkAuth}}
import { ClerkAuthenticationService } from '../src/business-profile/business-profile.controller.js';
{{/if}}
import { configureApplication } from '../src/configure-application.js';
import type { ServerEnvironment } from '../src/server-environment.js';

{{#if hasDatabaseWorkspace}}
function createTestBusinessDataRepository(): BusinessDataRepository {
  return {
    async findAppVariant(appVariantId) {
{{#ifSetupType 'white-label-apps'}}
      if (appVariantId === {{appVariants.[0].appVariantId}}) {
        return {
          appVariantId,
          role: null,
          standaloneRuntimeTenantId: null,
          profileName: {{{appVariants.[0].displayNameStringLiteral}}},
          profileDescription: 'The first white-label Business Data Example.',
        };
      }
      if (appVariantId === {{appVariants.[1].appVariantId}}) {
        return {
          appVariantId,
          role: null,
          standaloneRuntimeTenantId: null,
          profileName: {{{appVariants.[1].displayNameStringLiteral}}},
          profileDescription: 'The second white-label Business Data Example.',
        };
      }
{{/ifSetupType}}
{{#if isSingleAppRuntimeTenants}}
      if (appVariantId === {{appVariants.[0].appVariantId}}) {
        return {
          appVariantId,
          role: 'single-app',
          standaloneRuntimeTenantId: null,
          profileName: null,
          profileDescription: null,
        };
      }
{{/if}}
{{#ifSetupType 'generic-with-standalone-app-variants'}}
      if (appVariantId === {{appVariants.[0].appVariantId}}) {
        return {
          appVariantId,
          role: 'generic',
          standaloneRuntimeTenantId: null,
          profileName: null,
          profileDescription: null,
        };
      }
      if (appVariantId === {{appVariants.[1].appVariantId}}) {
        return {
          appVariantId,
          role: 'standalone',
          standaloneRuntimeTenantId: 103,
          profileName: null,
          profileDescription: null,
        };
      }
{{/ifSetupType}}
      return null;
    },
    async hasRuntimeTenantAccess(appVariantId, runtimeTenantId) {
      return (
        appVariantId === {{appVariants.[0].appVariantId}} &&
        [100, 101, 102].includes(runtimeTenantId)
      );
    },
    async findRuntimeTenant(runtimeTenantId) {
      const runtimeTenants = new Map<number, { name: string; description: string }>([
{{#if isSingleAppRuntimeTenants}}
        [100, { name: 'North Branch', description: 'The northern branch Business Data Example.' }],
        [101, { name: 'South Branch', description: 'The southern branch Business Data Example.' }],
        [102, { name: 'East Branch', description: 'The eastern branch Business Data Example.' }],
{{/if}}
{{#ifSetupType 'generic-with-standalone-app-variants'}}
        [100, { name: 'North Studio', description: 'The North Studio Business Data Example.' }],
        [101, { name: 'South Studio', description: 'The South Studio Business Data Example.' }],
        [102, { name: 'East Studio', description: 'The East Studio Business Data Example.' }],
        [103, { name: 'West Studio', description: 'The standalone West Studio Business Data Example.' }],
{{/ifSetupType}}
      ]);
      const runtimeTenant = runtimeTenants.get(runtimeTenantId);
      return runtimeTenant
        ? {
            runtimeTenantId,
            profileName: runtimeTenant.name,
            profileDescription: runtimeTenant.description,
          }
        : null;
    },
    async close() {},
  };
}
{{/if}}

describe('NestJS Backend', () => {
  let app: INestApplication;
  {{#if isClerkAuth}}
  let isAuthenticated = true;
  {{/if}}

  beforeAll(async () => {
    const testingModule = Test.createTestingModule({ imports: [AppModule] });
    {{#if hasDatabaseWorkspace}}
    testingModule.overrideProvider(BUSINESS_DATA_REPOSITORY).useValue({
      ...createTestBusinessDataRepository(),
      onApplicationShutdown: async () => {},
    });
    {{/if}}
    {{#if isClerkAuth}}
    testingModule.overrideProvider(ClerkAuthenticationService).useValue({
      isAuthenticated: () => isAuthenticated,
    });
    {{/if}}
    const moduleReference = await testingModule.compile();
    app = moduleReference.createNestApplication();
    const environment = app.get<ConfigService<ServerEnvironment, true>>(ConfigService);
    {{#if isClerkAuth}}
    configureApplication(
      app,
      environment.getOrThrow('CLIENT_ORIGIN', { infer: true }),
      (_request, _response, next) => next(),
    );
    {{else}}
    configureApplication(app, environment.getOrThrow('CLIENT_ORIGIN', { infer: true }));
    {{/if}}
    await app.init();
  });

  afterAll(async () => {
    await app.close();
  });

  {{#if isClerkAuth}}
  beforeEach(() => {
    isAuthenticated = true;
  });
  {{/if}}

  test('exposes public health without an Auth route', async () => {
    const health = await request(app.getHttpServer()).get('/health').expect(200);
    expect(health.body).toMatchObject({ status: 'ok' });
    await request(app.getHttpServer()).get('/api/auth/session').expect(404);
    {{#if isClerkAuth}}
    isAuthenticated = false;
    await request(app.getHttpServer())
      .get('/api/business-profile')
      .query({
        setupType: '{{setupType}}',
        appVariantId: {{appVariants.[0].appVariantId}},
        {{#if isSingleAppRuntimeTenants}}runtimeTenantId: 100,{{/if}}
        {{#ifSetupType 'generic-with-standalone-app-variants'}}runtimeTenantId: 100,{{/ifSetupType}}
      })
      .expect(401, { error: 'Authentication is required' });
    {{/if}}
  });

  test('{{#if isClerkAuth}}authenticated requests {{/if}}validate context and return Setup Type-scoped Business Data', async () => {
    await request(app.getHttpServer()).get('/api/business-profile').expect(400);
    await request(app.getHttpServer())
      .get('/api/business-profile')
      .query({ setupType: '{{setupType}}', appVariantId: 'not-an-integer' })
      .expect(400);
    await request(app.getHttpServer())
      .get('/api/business-profile')
      .query({ setupType: '{{setupType}}', appVariantId: 999 })
      .expect(404);
{{#ifSetupType 'white-label-apps'}}
    await request(app.getHttpServer())
      .get('/api/business-profile')
      .query({ setupType: 'single-app-runtime-tenants', appVariantId: {{appVariants.[0].appVariantId}} })
      .expect(400);
{{else}}
    await request(app.getHttpServer())
      .get('/api/business-profile')
      .query({ setupType: 'white-label-apps', appVariantId: {{appVariants.[0].appVariantId}} })
      .expect(400);
{{/ifSetupType}}

{{#ifSetupType 'white-label-apps'}}
    await request(app.getHttpServer())
      .get('/api/business-profile')
      .query({ setupType: '{{setupType}}', appVariantId: {{appVariants.[0].appVariantId}} })
      .expect(200, {
        profile: {
          name: {{{appVariants.[0].displayNameStringLiteral}}},
          description: 'The first white-label Business Data Example.',
        },
      });
    await request(app.getHttpServer())
      .get('/api/business-profile')
      .query({ setupType: '{{setupType}}', appVariantId: {{appVariants.[0].appVariantId}}, runtimeTenantId: 100 })
      .expect(403);
{{/ifSetupType}}
{{#if isSingleAppRuntimeTenants}}
    await request(app.getHttpServer())
      .get('/api/business-profile')
      .query({ setupType: '{{setupType}}', appVariantId: {{appVariants.[0].appVariantId}}, runtimeTenantId: 100 })
      .expect(200, {
        profile: {
          name: 'North Branch',
          description: 'The northern branch Business Data Example.',
        },
      });
    await request(app.getHttpServer())
      .get('/api/business-profile')
      .query({ setupType: '{{setupType}}', appVariantId: {{appVariants.[0].appVariantId}}, runtimeTenantId: 999 })
      .expect(403);
{{/if}}
{{#ifSetupType 'generic-with-standalone-app-variants'}}
    await request(app.getHttpServer())
      .get('/api/business-profile')
      .query({ setupType: '{{setupType}}', appVariantId: {{appVariants.[0].appVariantId}}, runtimeTenantId: 100 })
      .expect(200, {
        profile: {
          name: 'North Studio',
          description: 'The North Studio Business Data Example.',
        },
      });
    await request(app.getHttpServer())
      .get('/api/business-profile')
      .query({ setupType: '{{setupType}}', appVariantId: {{appVariants.[0].appVariantId}}, runtimeTenantId: 103 })
      .expect(403);
    await request(app.getHttpServer())
      .get('/api/business-profile')
      .query({ setupType: '{{setupType}}', appVariantId: {{appVariants.[1].appVariantId}} })
      .expect(403);
    await request(app.getHttpServer())
      .get('/api/business-profile')
      .query({ setupType: '{{setupType}}', appVariantId: {{appVariants.[1].appVariantId}}, runtimeTenantId: 100 })
      .expect(403);
    await request(app.getHttpServer())
      .get('/api/business-profile')
      .query({ setupType: '{{setupType}}', appVariantId: {{appVariants.[1].appVariantId}}, runtimeTenantId: 103 })
      .expect(200, {
        profile: {
          name: 'West Studio',
          description: 'The standalone West Studio Business Data Example.',
        },
      });
{{/ifSetupType}}
  });

  {{#if isClerkAuth}}
  test('sign-out Auth state invalidates protected Business Data access', async () => {
    const requestQuery = {
      setupType: '{{setupType}}',
      appVariantId: {{appVariants.[0].appVariantId}},
      {{#if isSingleAppRuntimeTenants}}runtimeTenantId: 100,{{/if}}
      {{#ifSetupType 'generic-with-standalone-app-variants'}}runtimeTenantId: 100,{{/ifSetupType}}
    };

    isAuthenticated = true;
    await request(app.getHttpServer())
      .get('/api/business-profile')
      .query(requestQuery)
      .expect(200);
    isAuthenticated = false;
    await request(app.getHttpServer())
      .get('/api/business-profile')
      .query(requestQuery)
      .expect(401, { error: 'Authentication is required' });
  });
  {{/if}}
});
