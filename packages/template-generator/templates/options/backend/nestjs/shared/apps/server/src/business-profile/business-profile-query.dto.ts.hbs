import { Type } from 'class-transformer';
import { IsEnum, IsInt, IsOptional, IsPositive } from 'class-validator';

enum SetupType {
  WhiteLabelApps = 'white-label-apps',
  SingleAppRuntimeTenants = 'single-app-runtime-tenants',
  GenericWithStandaloneAppVariants = 'generic-with-standalone-app-variants',
}

export class BusinessProfileQueryDto {
  @IsEnum(SetupType)
  setupType!: SetupType;

  @Type(() => Number)
  @IsInt()
  @IsPositive()
  appVariantId!: number;

  @Type(() => Number)
  @IsOptional()
  @IsInt()
  @IsPositive()
  runtimeTenantId?: number;
}
