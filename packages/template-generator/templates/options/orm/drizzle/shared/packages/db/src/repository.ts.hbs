import { and, eq, sql } from 'drizzle-orm';
import { drizzle } from 'drizzle-orm/node-postgres';
import { Pool } from 'pg';

import {
  appVariantRuntimeTenantAccess,
  appVariants,
  runtimeTenants,
} from './schema.js';

export type AppVariantBusinessData = typeof appVariants.$inferSelect;
export type RuntimeTenantBusinessData = typeof runtimeTenants.$inferSelect;

export type BusinessDataRepository = {
  findAppVariant(appVariantId: number): Promise<AppVariantBusinessData | null>;
  hasRuntimeTenantAccess(appVariantId: number, runtimeTenantId: number): Promise<boolean>;
  findRuntimeTenant(runtimeTenantId: number): Promise<RuntimeTenantBusinessData | null>;
  close(): Promise<void>;
};

export function validatePostgresqlDatabaseUrl(databaseUrl: string): string {
  let parsedUrl: URL;

  try {
    parsedUrl = new URL(databaseUrl);
  } catch {
    throw new Error('DATABASE_URL must be a valid PostgreSQL URL.');
  }

  if (parsedUrl.protocol !== 'postgresql:' && parsedUrl.protocol !== 'postgres:') {
    throw new Error('DATABASE_URL must use the postgresql or postgres protocol.');
  }

  if (!parsedUrl.hostname || parsedUrl.pathname === '/' || parsedUrl.pathname.length === 0) {
    throw new Error('DATABASE_URL must identify a PostgreSQL host and database.');
  }

  return databaseUrl;
}

export function createPostgresqlDrizzleDatabase(databaseUrl: string) {
  const pool = new Pool({ connectionString: validatePostgresqlDatabaseUrl(databaseUrl) });
  return drizzle({ client: pool });
}

export type TenkitDatabase = ReturnType<typeof createPostgresqlDrizzleDatabase>;

export function createBusinessDataRepository(databaseUrl: string): BusinessDataRepository {
  const database = createPostgresqlDrizzleDatabase(databaseUrl);

  return {
    async findAppVariant(appVariantId) {
      const rows = await database
        .select()
        .from(appVariants)
        .where(eq(appVariants.appVariantId, appVariantId));
      return rows[0] ?? null;
    },
    async hasRuntimeTenantAccess(appVariantId, runtimeTenantId) {
      const rows = await database
        .select({ runtimeTenantId: appVariantRuntimeTenantAccess.runtimeTenantId })
        .from(appVariantRuntimeTenantAccess)
        .where(
          and(
            eq(appVariantRuntimeTenantAccess.appVariantId, appVariantId),
            eq(appVariantRuntimeTenantAccess.runtimeTenantId, runtimeTenantId),
          ),
        );
      return rows.length > 0;
    },
    async findRuntimeTenant(runtimeTenantId) {
      const rows = await database
        .select()
        .from(runtimeTenants)
        .where(eq(runtimeTenants.runtimeTenantId, runtimeTenantId));
      return rows[0] ?? null;
    },
    async close() {
      await database.$client.end();
    },
  };
}

export async function inspectPostgresqlTableNames(databaseUrl: string): Promise<string[]> {
  const database = createPostgresqlDrizzleDatabase(databaseUrl);

  try {
    const rows = await database.execute<{ table_name: string }>(sql`
      SELECT table_name
      FROM information_schema.tables
      WHERE table_schema = 'public'
      ORDER BY table_name
    `);
    return rows.rows.map(({ table_name: tableName }) => tableName);
  } finally {
    await database.$client.end();
  }
}
