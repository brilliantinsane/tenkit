{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    {{#if isDrizzleOrm}}
    "skipLibCheck": true,
    {{/if}}
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node", "bun"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
