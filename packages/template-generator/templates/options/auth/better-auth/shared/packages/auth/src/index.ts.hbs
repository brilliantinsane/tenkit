import { expo } from '@better-auth/expo';
{{#if isDrizzleOrm}}
import { drizzleAdapter } from '@better-auth/drizzle-adapter';
import { schema, type TenkitDatabase } from '@tenkit/db';
{{else}}
import { {{#if isMysqlDatabase}}createMysqlPrismaClient{{else}}createPostgresqlPrismaClient{{/if}} } from '@tenkit/db';
{{/if}}
import { betterAuth, type BetterAuthOptions } from 'better-auth';
{{#if isPrismaOrm}}
import { prismaAdapter } from 'better-auth/adapters/prisma';
{{/if}}

import { createTrustedOrigins } from './trusted-origins.js';

export type CreateTenkitAuthInput = {
  {{#if isDrizzleOrm}}
  database: TenkitDatabase;
  {{else}}
  databaseUrl: string;
  {{/if}}
  baseUrl: string;
  secret: string;
  clientOrigin: string;
  development: boolean;
};

export type TenkitAuth = ReturnType<typeof betterAuth>;
export type TenkitAuthRuntime = {
  auth: TenkitAuth;
  {{#if isPrismaOrm}}
  close(): Promise<void>;
  {{/if}}
};

export function createTenkitAuth({
  {{#if isDrizzleOrm}}
  database,
  {{else}}
  databaseUrl,
  {{/if}}
  baseUrl,
  secret,
  clientOrigin,
  development,
}: CreateTenkitAuthInput): TenkitAuthRuntime {
  {{#if isPrismaOrm}}
  const database = {{#if isMysqlDatabase}}createMysqlPrismaClient{{else}}createPostgresqlPrismaClient{{/if}}(databaseUrl);
  {{/if}}
  const options: BetterAuthOptions = {
    appName: {{projectNameStringLiteral}},
    baseURL: baseUrl,
    secret,
    database: {{#if isDrizzleOrm}}drizzleAdapter(database, { provider: 'pg', schema }){{else}}prismaAdapter(database, { provider: '{{#if isMysqlDatabase}}mysql{{else}}postgresql{{/if}}' }){{/if}},
    emailAndPassword: {
      enabled: true,
      requireEmailVerification: false,
    },
    trustedOrigins: createTrustedOrigins(clientOrigin, development),
    plugins: [expo()],
  };
  const auth = betterAuth(options);

  return {
    auth,
    {{#if isPrismaOrm}}
    close: () => database.$disconnect(),
    {{/if}}
  };
}
