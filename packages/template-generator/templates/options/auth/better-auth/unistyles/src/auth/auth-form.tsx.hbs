import { Link } from 'expo-router';
import { Pressable, Text, TextInput, View } from 'react-native';
import { StyleSheet } from 'react-native-unistyles';

import { type AuthFormMode, useBetterAuthForm } from './use-better-auth-form';

export function AuthForm({ mode }: { mode: AuthFormMode }) {
  const form = useBetterAuthForm(mode);
  return (
    <View style={styles.screen}>
      <Text style={styles.title}>{form.isSignUp ? 'Create account' : 'Sign in'}</Text>
      <Text style={styles.secondary}>{form.isSignUp ? 'Start an immediate Better Auth session.' : 'Continue to your Business Data Example.'}</Text>
      {form.isSignUp ? <TextInput style={styles.input} onChangeText={form.setName} placeholder="Name" value={form.name} /> : null}
      <TextInput style={styles.input} autoCapitalize="none" keyboardType="email-address" onChangeText={form.setEmail} placeholder="Email" value={form.email} />
      <TextInput style={styles.input} autoCapitalize="none" onChangeText={form.setPassword} placeholder="Password" secureTextEntry value={form.password} />
      {form.isSignUp ? <TextInput style={styles.input} onChangeText={form.setConfirmPassword} placeholder="Confirm Password" secureTextEntry value={form.confirmPassword} /> : null}
      {form.errorMessage ? <Text style={styles.secondary}>{form.errorMessage}</Text> : null}
      <Pressable style={styles.button} disabled={form.isSubmitting} onPress={() => void form.submitCredentials()}><Text style={styles.buttonText}>{form.isSubmitting ? 'Working...' : form.isSignUp ? 'Create account' : 'Sign in'}</Text></Pressable>
      <Link href={form.isSignUp ? '/sign-in' : '/sign-up'}>{form.isSignUp ? 'Already have an account? Sign in' : 'Need an account? Register'}</Link>
    </View>
  );
}

const styles = StyleSheet.create((theme) => ({
  screen: { flex: 1, justifyContent: 'center', gap: 14, padding: 24, backgroundColor: theme.colors.background },
  title: { color: theme.colors.typography, fontSize: 30, fontWeight: '700' },
  secondary: { color: theme.colors.typography },
  input: { minHeight: 48, borderWidth: StyleSheet.hairlineWidth, borderColor: theme.colors.outline, borderRadius: 12, paddingHorizontal: 14, color: theme.colors.typography },
  button: { minHeight: 48, alignItems: 'center', justifyContent: 'center', borderRadius: 12, backgroundColor: theme.colors.primary },
  buttonText: { color: theme.colors.onPrimary, fontWeight: '600' },
}));
