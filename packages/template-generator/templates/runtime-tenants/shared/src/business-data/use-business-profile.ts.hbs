{{#if isConvexBackend}}
import { api } from '@server/convex/_generated/api';
import { useQuery } from 'convex/react';
{{#if isBetterAuth}}
import { authClient } from '@/auth/auth-client';
import { resolveProtectedConvexQueryState } from '@/auth/auth-session-boundary';
{{/if}}
{{/if}}
{{#if isNodeBackend}}
{{#unless isClerkAuth}}
import { fetch } from 'expo/fetch';
{{/unless}}
import { useEffect, useState } from 'react';
{{#if isClerkAuth}}
import { useAuth } from '@clerk/expo';
import { requestClerkBusinessProfile } from '@/auth/clerk-business-profile-client';
{{/if}}
{{#if isBetterAuth}}
import { getBetterAuthCookie } from '@/auth/auth-client';
{{/if}}
{{/if}}
{{#if hasServerWorkspace}}
import { useAppVariantConfig } from '@/hooks/use-app-variant-config';
{{/if}}

import { useActiveRuntimeTenant } from '@/hooks/use-active-runtime-tenant';

export type BusinessProfile = {
  name: string;
  description: string;
};

export type BusinessProfileState = {
  profile: BusinessProfile | null;
  error: string | null;
  isLoading: boolean;
};

{{#if isConvexBackend}}
export function useBusinessProfile(): BusinessProfileState {
  const { appVariant } = useAppVariantConfig();
  const { activeRuntimeTenantId } = useActiveRuntimeTenant();
  {{#if isBetterAuth}}
  const { data: session, isPending } = authClient.useSession();
  const protectedQueryState = resolveProtectedConvexQueryState(isPending, session !== null);
  {{/if}}
  const businessProfileRequest = {
    setupType: '{{setupType}}' as const,
    appVariantId: appVariant.id,
    runtimeTenantId: activeRuntimeTenantId,
  };
  const profile = useQuery(
    api.businessProfiles.get,
    {{#if isBetterAuth}}protectedQueryState === 'query' ? businessProfileRequest : 'skip'{{else}}businessProfileRequest{{/if}},
  );

  return {
    profile: profile ?? null,
    error: null,
    isLoading: {{#if isBetterAuth}}protectedQueryState === 'skip' || {{/if}}profile === undefined,
  };
}
{{else}}
{{#if isNodeBackend}}
function resolveBackendUrl(): URL {
  const configuredUrl = process.env.EXPO_PUBLIC_API_URL;
  if (!configuredUrl) {
    throw new Error('EXPO_PUBLIC_API_URL is required for the selected Node Backend.');
  }

  let backendUrl: URL;
  try {
    backendUrl = new URL(configuredUrl);
  } catch {
    throw new Error('EXPO_PUBLIC_API_URL must be an absolute http or https URL.');
  }
  if (!['http:', 'https:'].includes(backendUrl.protocol)) {
    throw new Error('EXPO_PUBLIC_API_URL must be an absolute http or https URL.');
  }

  return backendUrl;
}

{{#unless isClerkAuth}}
function parseBusinessProfile(responseBody: unknown): BusinessProfile {
  if (
    typeof responseBody !== 'object' ||
    responseBody === null ||
    !('profile' in responseBody) ||
    typeof responseBody.profile !== 'object' ||
    responseBody.profile === null ||
    !('name' in responseBody.profile) ||
    typeof responseBody.profile.name !== 'string' ||
    !('description' in responseBody.profile) ||
    typeof responseBody.profile.description !== 'string'
  ) {
    throw new Error('The Node Backend returned invalid Business Data Example data.');
  }

  return {
    name: responseBody.profile.name,
    description: responseBody.profile.description,
  };
}
{{/unless}}

export function useBusinessProfile(): BusinessProfileState {
  const { appVariant } = useAppVariantConfig();
  const { activeRuntimeTenantId } = useActiveRuntimeTenant();
  {{#if isClerkAuth}}
  const { getToken } = useAuth();
  {{/if}}
  const [state, setState] = useState<BusinessProfileState>({
    profile: null,
    error: null,
    isLoading: true,
  });

  useEffect(() => {
    const controller = new AbortController();
    let isActive = true;

    setState({ profile: null, error: null, isLoading: true });
    async function loadBusinessProfile(): Promise<void> {
      try {
        const requestUrl = new URL('/api/business-profile', resolveBackendUrl());
        requestUrl.searchParams.set('setupType', '{{setupType}}');
        requestUrl.searchParams.set('appVariantId', String(appVariant.id));
        requestUrl.searchParams.set('runtimeTenantId', String(activeRuntimeTenantId));
        {{#if isClerkAuth}}
        const profile = await requestClerkBusinessProfile({
          requestUrl,
          signal: controller.signal,
          getToken,
        });
        {{else}}
        const response = await fetch(requestUrl, {
          {{#if isBetterAuth}}
          credentials: 'omit',
          headers: { Cookie: getBetterAuthCookie() },
          {{/if}}
          signal: controller.signal,
        });
        if (!response.ok) {
          throw new Error(`Business Data Example request failed with HTTP ${response.status}.`);
        }
        const responseBody: unknown = await response.json();
        const profile = parseBusinessProfile(responseBody);
        {{/if}}
        if (isActive) {
          setState({ profile, error: null, isLoading: false });
        }
      } catch (error: unknown) {
        if (!isActive || (error instanceof Error && error.name === 'AbortError')) {
          return;
        }
        setState({
          profile: null,
          error: error instanceof Error ? error.message : 'Business Data Example request failed.',
          isLoading: false,
        });
      }
    }

    void loadBusinessProfile();

    return () => {
      isActive = false;
      controller.abort();
    };
  }, [activeRuntimeTenantId, appVariant.id{{#if isClerkAuth}}, getToken{{/if}}]);

  return state;
}
{{else}}
export function useBusinessProfile(): BusinessProfileState {
  const { activeRuntimeTenant } = useActiveRuntimeTenant();

  return {
    profile: {
      name: activeRuntimeTenant.name,
      description: `The ${activeRuntimeTenant.name} local Business Data Example.`,
    },
    error: null,
    isLoading: false,
  };
}
{{/if}}
{{/if}}
