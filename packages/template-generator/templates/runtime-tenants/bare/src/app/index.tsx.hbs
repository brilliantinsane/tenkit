import { StyleSheet, View } from 'react-native';

import { useBusinessProfile } from '@/business-data/use-business-profile';
{{#if hasAuth}}
import { SignOutButton } from '@/auth/sign-out-button';
{{/if}}
import { ThemedText } from '@/components/themed-text';
import { ThemedView } from '@/components/themed-view';
import { globalStyles } from '@/constants/globals';
import { useActiveRuntimeTenant } from '@/hooks/use-active-runtime-tenant';
import { useAppVariantConfig } from '@/hooks/use-app-variant-config';

export default function HomeScreen() {
  const { appVariant } = useAppVariantConfig();
  const { activeRuntimeTenant, activeRuntimeTenantId } = useActiveRuntimeTenant();
  const { profile, error, isLoading } = useBusinessProfile();

  return (
    <ThemedView style={[globalStyles.centeredContainer, styles.screen]}>
      <ThemedText themeColor="accent">
        Tenkit
      </ThemedText>
      <ThemedText type="title" style={styles.title}>
        Runtime Tenants App
      </ThemedText>
      <View style={styles.details}>
        <ThemedText type="code" selectable>
          Business Data: {isLoading ? 'Loading' : (profile?.name ?? 'Unavailable')}
        </ThemedText>
        {profile ? <ThemedText>{profile.description}</ThemedText> : null}
        {error ? <ThemedText>{error}</ThemedText> : null}
        <ThemedText type="code">Auth: {{#if isClerkAuth}}clerk{{else}}{{#if isBetterAuth}}better-auth{{else}}none{{/if}}{{/if}}</ThemedText>
        <ThemedText type="code" selectable>
          App Variant: {appVariant.slug}
        </ThemedText>
        <ThemedText type="code" selectable>
          Active Runtime Tenant: {activeRuntimeTenant.name}
        </ThemedText>
        <ThemedText type="code" selectable>
          Active Runtime Tenant ID: {activeRuntimeTenantId}
        </ThemedText>
      </View>
      {{#if hasAuth}}<SignOutButton />{{/if}}
      <ThemedText style={styles.note} themeColor="secondaryText">
        A generated Expo SDK 57 app with one native App Variant and selectable Runtime Tenants.
      </ThemedText>
    </ThemedView>
  );
}

const styles = StyleSheet.create({
  screen: {
    gap: 16,
    padding: 24,
  },
  title: {
    textAlign: 'center',
  },
  details: {
    gap: 4,
    minWidth: 220,
  },
  note: {
    maxWidth: 340,
    textAlign: 'center',
  },
});
